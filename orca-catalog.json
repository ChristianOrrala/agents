  "catalogVersion": 2,
  "name": "christianorrala",
  "owner": "christianorrala",
  "plugins": [
    {
      "id": "christianorrala.workflow-watch-orca",
      "source": {
        "kind": "git",
        "url": "https://github.com/ChristianOrrala/orca-workflow-watch.git",
        "ref": "main"
      },
      "description": "Every workflow run, live, beside your code. Watch Open Dynamic Workflows and AgentPrism runs in Orca's sidebar, from this computer and your paired servers: each phase and agent on a timeline, the whole run log, and a notification when a run finishes or needs you. A community plugin, not made or endorsed by Orca.",
      "categories": [
        "workflows",
        "agents"
      ],
      "releases": [
        {
          "version": "0.5.0",
          "commit": "aadbea12552b47e88c4dc8ac2ad8642cfe2c3de7",
          "contentHash": "3c46ef79a1a2a39fe61140a9bacc466b1a0aabad5dac7b2dbdcb2b829ab32af6",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.248",
          "name": "Workflow Watch for Orca",
          "contributes": [
            {
              "kind": "panels",
              "name": "Workflows"
            },
            {
              "kind": "commands",
              "name": "Workflow Watch for Orca: Open Workflows"
            },
            {
              "kind": "statusBarItems",
              "name": "Workflows · Idle"
            }
          ],
          "capabilities": [
            "settings:own",
            "notifications:show"
          ],
          "updatedAt": "2026-11-21",
          "changelog": "The status bar shows workflow activity: how many runs are running, waiting or paused, the last result when nothing runs, and the active runs on hover. Click it to open Workflows."
