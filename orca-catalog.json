          "minimumOrca": "1.4.248",
          "name": "Workflow Watch for Orca",
          "contributes": [
            {
              "kind": "panels",
              "name": "Workflows"
            },
            {
              "kind": "commands",
              "name": "Workflow Watch for Orca: Show or hide the sidebar"
            },
            {
